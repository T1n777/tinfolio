---
const { direction = 'up', class: className = '' } = Astro.props;
---

<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path
    d={direction === 'down' ? 'M12 4v16m-6-6 6 6 6-6' : 'M5 19 19 5M5 5h14v14'}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
