---
import Layout from '../components/Layout.astro';
import HeroArt from '../components/HeroArt';
import GlassLink from '../components/GlassLink';
import GlassProfile from '../components/GlassProfile';
import NameArt from '../components/NameArt';
import Arrow from '../components/Arrow.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { person, projects, otherProjects } from '../data/portfolio';
---

<Layout home>
  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <HeroArt client:load />
      <div class="hero-content container">
        <div class="hero-topline">
          <span class="eyebrow">
            <span class="status-dot"></span> A CURIOUS MIND. A HANDS-ON BUILDER.
          </span>
          <span class="eyebrow hero-coordinate">SAN FRANCISCO, CA ↗</span>
        </div>
        <h1 id="hero-title" class="sr-only">
          {person.name} — software engineer and systems builder.
        </h1>
        <NameArt client:load />
        <div class="hero-bottom">
          <div class="hero-intro">
            <p>
              I like knowing how things work.
              <br />
              <span>I like building them even more.</span>
            </p>
            <p class="hero-description">
              Computer science and software engineering.
              <br />
              Exploring systems, architecture, and the software in between.
            </p>
          </div>
          <div class="hero-actions">
            <GlassLink href="#work" label="Explore my work" direction="down" client:load />
            <GlassLink
              href="/resume.pdf"
              label="Read my résumé"
              external
              client:load
            />
          </div>
        </div>
        <div class="hero-footnote">
          <span>SYSTEMS / SECURITY / SOFTWARE</span>
          <span class="scroll-note">
            MOVE TO EXPLORE <span aria-hidden="true">↗</span>
          </span>
        </div>
      </div>
    </section>

    <section id="work" class="work-section container" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="section-index">01 /</span> SELECTED WORK
          </p>
          <h2 id="work-title">
            <span class="sr-only">Selected work.</span>
            <NameArt text="Selected work." variant="word" client:visible />
          </h2>
        </div>
        <p class="section-intro">
          From the server under my desk to the
          <br class="desktop-break" /> network across campus. Real problems,
          <br class="desktop-break" /> explored through code.
        </p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <ProjectVisual project={project} />
            <div class="project-meta">
              <span class="eyebrow">
                {project.number} — {project.category}
              </span>
              <span class="project-year">{project.year}</span>
            </div>
            <div class="project-name">
              <h3>
                <a href={`/work/${project.slug}/`} class="project-card-link">
                  <span class="sr-only">Explore </span>
                  {project.name}
                </a>
              </h3>
              <span class="circle-arrow">
                <Arrow />
              </span>
            </div>
            <p class="project-summary">{project.summary}</p>
            <div class="project-stack">
              {project.stack.slice(0, 4).map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
      <div class="more-work-heading">
        <h3>
          Also on my workbench<span>.</span>
        </h3>
        <a
          href={person.github + '?tab=repositories'}
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          All repositories <Arrow />
        </a>
      </div>
      <div class="project-index">
        {otherProjects.map((project, i) => (
          <article class="index-row">
            <span class="index-number">0{i + 5}</span>
            <div class="index-name">
              <h4>
                <a href={project.href} target="_blank" rel="noopener noreferrer">
                  {project.name}
                  <span class="sr-only"> on GitHub</span>
                </a>
              </h4>
              <p>{project.description}</p>
            </div>
            <span class="index-stack">{project.stack}</span>
            <div class="index-links">
              {project.live && (
                <a
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.name} live site`}
                >
                  Live ↗
                </a>
              )}
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${project.name} source on GitHub`}
              >
                <Arrow />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="container about-grid">
        <div class="about-aside">
          <p class="eyebrow">
            <span class="section-index">02 /</span> THE PERSON BEHIND THE CODE
          </p>
          <GlassProfile client:visible />
          <span class="about-caption">
            Find me online on{' '}
            <a href={person.github} target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
          </span>
        </div>
        <div class="about-copy">
          <h2 id="about-title">
            Understand it.
            <br />
            Take it apart.
            <br />
            <span class="muted-word">Build something.</span>
          </h2>
          <p>
            I’m a software engineer and builder. I’m drawn to the
            foundations of software engineering: how systems stay resilient, how data flows reliably,
            and how thoughtful architecture powers modern applications.
          </p>
          <p>
            I learn best by building hands-on. Whether exploring distributed systems, diving into
            software security, or crafting intuitive tools that solve real-world problems, I focus on
            writing clean, efficient code and understanding technology from the ground up.
          </p>
          <div class="education-note">
            <span class="eyebrow">CURRENTLY</span>
            <p>
              B.S. in Computer Science <span>University · 2022–2026</span>
            </p>
          </div>
        </div>
      </div>
      <div class="container toolkit">
        <p class="eyebrow">TOOLS I REACH FOR</p>
        <div class="toolkit-groups">
          <div>
            <span class="toolkit-label">01 / LANGUAGES</span>
            <p>
              Python · Kotlin · C<br />
              Bash · SQL · HTML / CSS
            </p>
          </div>
          <div>
            <span class="toolkit-label">02 / SYSTEMS</span>
            <p>
              Linux · Docker · Nginx
              <br />
              Tailscale · Systemd · Git
            </p>
          </div>
          <div>
            <span class="toolkit-label">03 / APPLICATIONS & RESEARCH</span>
            <p>
              Jetpack Compose · OpenCV
              <br />
              MediaPipe · NumPy · Radare2
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="experience"
      class="experience-section container"
      aria-labelledby="experience-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="section-index">03 /</span> EXPERIENCE & COMMUNITY
          </p>
          <h2 id="experience-title">
            Learning in
            <br />
            <span class="muted-word">good company.</span>
          </h2>
        </div>
        <p class="section-intro">
          Research, open source, and the people
          <br class="desktop-break" /> who make the work better.
        </p>
      </div>
      <div class="experience-list">
        <article class="experience-row">
          <div class="experience-date">
            JAN — APR 2026<span>ENGINEERING INTERNSHIP</span>
          </div>
          <div>
            <h3>Software Engineering Intern</h3>
            <p class="experience-org">Tech Labs · Systems Team</p>
            <p>
              Worked on real-time computer vision and distributed systems pipelines.
              Researched temporal cohesion algorithms to stabilize frame data and optimized
              backend services for low latency.
            </p>
          </div>
          <span class="experience-location">SAN FRANCISCO, CA</span>
        </article>
        <article class="experience-row">
          <div class="experience-date">
            AUG 2025 — PRESENT<span>OPEN SOURCE</span>
          </div>
          <div>
            <h3>Open Source Contributor</h3>
            <p class="experience-org">Developer Community</p>
            <p>
              Part of an open-source community built around software tools and knowledge sharing.
              Collaborating on modern web stacks, tooling libraries, and software engineering practices.
            </p>
          </div>
          <span class="experience-location">REMOTE</span>
        </article>
      </div>
      <div class="resume-strip">
        <span>For the full picture.</span>
        <GlassLink
          href="/resume.pdf"
          label="Download my résumé"
          direction="down"
          download
          client:visible
        />
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="container">
        <p class="eyebrow">
          <span class="section-index">04 /</span> KEEP THE CONVERSATION GOING
        </p>
        <div class="contact-heading">
          <h2 id="contact-title">
            Something interesting
            <br />
            <span class="muted-word">on your mind?</span>
          </h2>
          <GlassLink
            href={`mailto:${person.email}`}
            label="Say hello"
            className="contact-glass-link"
            client:visible
          />
        </div>
        <div class="contact-bottom">
          <p>
            A project, a research question, or a good conversation.
            <br />
            I’d love to hear about it.
          </p>
          <div class="contact-actions">
            <a class="email-link" href={`mailto:${person.email}`}>
              {person.email} <Arrow />
            </a>
            <button
              type="button"
              id="copy-email"
              hidden
              aria-label="Copy email address"
              data-email={person.email}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect
                  x="8"
                  y="8"
                  width="12"
                  height="12"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path d="M16 8V4H4v12h4" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
            <span id="copy-status" role="status" class="copy-status"></span>
          </div>
        </div>
        <div class="social-links">
          <a href={person.github} target="_blank" rel="noopener noreferrer">
            GitHub <Arrow />
          </a>
          <a href={person.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <Arrow />
          </a>
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">
            Résumé <Arrow />
          </a>
          <span>
            LOCATION ·{' '}
            <time id="local-time" aria-label="Current local time">
              UTC
            </time>
          </span>
        </div>
      </div>
    </section>
  </main>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-email');
    const status = document.querySelector<HTMLElement>('#copy-status');
    if (copyButton) copyButton.hidden = false;
    let reset: ReturnType<typeof setTimeout>;
    copyButton?.addEventListener('click', async () => {
      if (!status) return;
      clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(copyButton.dataset.email ?? '');
        status.textContent = 'Copied!';
      } catch {
        status.textContent = 'Select the email to copy it.';
      }
      reset = setTimeout(() => {
        status.textContent = '';
      }, 3500);
    });
    const clock = document.querySelector<HTMLTimeElement>('#local-time');
    const updateTime = () => {
      if (clock)
        clock.textContent =
          new Intl.DateTimeFormat('en-US', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
          }).format(new Date());
    };
    updateTime();
    setInterval(updateTime, 60000);
  </script>
</Layout>
