---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { getBlogPosts, readingTime, formatDate } from '../../lib/blog';
import { person } from '../../data/portfolio';
import '../../styles/blog.css';

export async function getStaticPaths() {
  return (await getBlogPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — ${person.name}`}
  description={post.data.description}
  staticNavigation
>
  <main id="main" class="blog blog-post container">
    <article>
      <header class="blog-heading" id="top">
        <a href="/blog/" class="text-link">
          ← All articles
        </a>
        <div class="blog-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>{readingTime(post)}</span>
          {post.data.draft && <span class="draft-label">Draft</span>}
        </div>
        <h1>{post.data.title}</h1>
        <p class="blog-deck">{post.data.description}</p>
        {post.data.updatedDate && (
          <p class="blog-updated">
            Updated{' '}
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
          </p>
        )}
        {!!post.data.tags?.length && (
          <ul class="blog-tags" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
      </header>
      <div class="blog-prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>
